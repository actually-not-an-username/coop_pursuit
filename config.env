# Redo experiment defaults; override with environment variables or command-line flags (see main.py).
GLOBAL_SEED=1
NUM_EPISODES=2048
ROLLOUT_EPISODES=32
MAX_STEPS=100
RENDER=false
HIDDEN_DIM=128
SHAPING=true

NUM_PURSUERS=3
PREY_TYPE=fleeing
FLEE_PROB=0.5
FLEE_BOUNDARY=0.8
FLEE_PUSH=2.5

# Masked training: ~35% of agent-steps blind (was ~15%); 10% of episodes stay blackout-free
MASKED_TRAINING=false
TRAIN_BLACKOUT_PROB=0.9
TRAIN_BLACKOUT_START_MIN=1
TRAIN_BLACKOUT_START_MAX=10
TRAIN_BLACKOUT_MIN_LEN=20
TRAIN_BLACKOUT_MAX_LEN=80
TRAIN_BLACKOUT_PERMANENT_PROB=0.5

# Blackout design: external sensing lost, own velocity/position kept; actor gets a blind flag;
# critic knows who is blind
KEEP_PROPRIOCEPTION=true
BLIND_FLAG=true
CRITIC_BLIND_MASK=true

# Train-until-competent: extend in 320-episode chunks while best no-blackout validation < 75%,
# up to 4096 episodes
VAL_THRESHOLD=0.75
EXTENSION_EPISODES=320
MAX_EPISODES=4096

EVAL_INTERVAL_UPDATES=3
EVAL_EPISODES=100
EVAL_SEED=10_000
VAL_BLACKOUT_LENGTH=20
BLACKOUT_START_MIN=1
BLACKOUT_START_MAX=30

TEST_EPISODES=300
TEST_SEED=20_000
RUNS_DIR=runs
